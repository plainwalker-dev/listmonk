LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
# Explicitly restrict the lists this integration can access, e.g. 1,2.
LISTMONK_ALLOWED_LIST_IDS=
# Keep false until migration, SES and approval checks pass.
ENABLE_SEND=false
# Optional distinct sender token, with API permission only on its own allowlist.
# Set all three together. It needs campaigns:send and per-list list:get.
LISTMONK_SEND_API_USER=
LISTMONK_SEND_API_TOKEN=
LISTMONK_SEND_ALLOWED_LIST_IDS=
# stdio works locally; http requires the OAuth configuration below.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3100
# Public HTTPS URL of /mcp (also the OAuth audience).
MCP_RESOURCE_URL=https://newsletter.finchnow.com/mcp
# Configure an OAuth provider that supports authorization code + PKCE and
# ChatGPT client registration (CIMD, DCR or static client credentials).
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# OAuth access tokens must contain newsletter:manage, and additionally
# newsletter:send for the send tool. Use JWT access tokens, not ID tokens.
