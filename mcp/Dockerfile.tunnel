FROM node:22-bookworm-slim AS tunnel
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*
# Official OpenAI release. This pinned image supports the Finch amd64 VM.
RUN curl -fsSL --retry 2 -o /tmp/tunnel.zip \
      https://github.com/openai/tunnel-client/releases/download/v0.0.19/tunnel-client-v0.0.19-linux-amd64.zip \
    && echo '9ee9448592345a9dd1517fb79791ab54d24f051142eb92bcbe8cd355effc9142  /tmp/tunnel.zip' | sha256sum -c - \
    && unzip -j /tmp/tunnel.zip 'tunnel-client' -d /usr/local/bin \
    && chmod 755 /usr/local/bin/tunnel-client

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=tunnel /usr/local/bin/tunnel-client /usr/local/bin/tunnel-client
COPY --from=tunnel /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --chown=node:node src ./src
USER node
ENV MCP_TRANSPORT=stdio HEALTH_LISTEN_ADDR=127.0.0.1:8080 LOG_LEVEL=warn LOG_FORMAT=json
ENTRYPOINT ["tunnel-client", "run", "--mcp.command", "node /app/src/index.mjs"]
